PORT=3000
NODE_ENV=development

# Base del portal COES
COES_BASE_URL=https://www.coes.org.pe

# Timeout en ms para requests salientes
HTTP_TIMEOUT_MS=30000

# Tamaño máximo de descarga (bytes) — Excel del SEIN pueden ser grandes
MAX_DOWNLOAD_BYTES=52428800

# CORS — separar por comas, o * para abrir
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Etapa 0 — Supabase (schema enerku en el proyecto de WaterKu)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ENERKU_SCHEMA=enerku
